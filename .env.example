# Random string, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Where the SQLite database and uploads live. One directory = one backup.
LIBRERO_DATA_DIR=./data

# Bootstrap administrator, used only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sent to Open Library so they can reach you about traffic, per their API policy.
LIBRERO_CONTACT_EMAIL=you@example.com

# Optional: raises Google Books quota. Lookups work without it.
GOOGLE_BOOKS_API_KEY=

# Largest ebook file accepted per upload.
MAX_UPLOAD_MB=100
