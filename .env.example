# Random string, at least 32 characters. Generate with: openssl rand -base64 48
SESSION_SECRET=

# Where the SQLite database and uploads live. One directory = one backup.
LIBRERO_DATA_DIR=./data

# Bootstrap administrator, used only when the users table is empty.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Sent to Open Library so they can reach you about traffic, per their API policy.
LIBRERO_CONTACT_EMAIL=you@example.com

# Strongly recommended. Google Books answers unauthenticated callers with HTTP
# 429 much of the time, which makes the fallback effectively dead without a key.
# Open Library alone still covers most books. Free key:
# https://console.cloud.google.com/apis/library/books.googleapis.com
GOOGLE_BOOKS_API_KEY=

# Cover images pasted as a URL are downloaded by the server, so by default it
# refuses addresses on private networks — otherwise every signed-in user could
# probe your LAN, your other containers and the cloud metadata endpoint.
# Set this to true only if you want to pull covers from a server on your own
# network, such as a Calibre instance.
ALLOW_PRIVATE_COVER_URLS=false
